# Frontend configuration. Copy to .env.local and fill in.
# .env.local is gitignored; nothing here is secret, but the values differ per
# environment.

# Base URL of the ForenScreen API.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Neon Managed Auth, reached through a same-origin proxy on purpose.
#
# Neon Auth lives on a different host from the app, which makes its session
# cookie third-party - and browsers block third-party cookies by default, so
# sign-in appears to succeed and the session is never seen again. Proxying it
# under our own origin (see `server.proxy` in vite.config.js) makes the cookie
# first-party.
#
# A production deployment needs the same arrangement: an equivalent rewrite at
# the edge, not a direct cross-origin URL. The value must be absolute - the SDK
# rejects a relative base URL - but it points at this app's own origin.
#
# HTTPS matters in development too: Neon names its session cookie
# __Secure-neon-auth.session_token, and the __Secure- prefix is refused on an
# http:// origin even though localhost is a secure context. Over http the
# session is silently never stored. vite.config.js enables a self-signed
# certificate for exactly this reason.
VITE_NEON_AUTH_URL=https://localhost:5173/api/auth

# Server-side only (no VITE_ prefix, so it is not shipped to the browser).
# The branch Auth URL including its path - get it from `neon neon-auth status`.
NEON_AUTH_UPSTREAM=
