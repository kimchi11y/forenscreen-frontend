{
  "manifest_version": 3,
  "name": "ForenScreen",
  "version": "0.1.0",
  "description": "Register your screenshots and photos with ForenScreen before you share them. Always asks first.",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "ForenScreen" },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*", "https://x.com/*", "https://twitter.com/*"],
      "js": ["content-social.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://localhost:5173/*", "http://localhost:5173/*"],
      "js": ["content-app.js"],
      "run_at": "document_start"
    }
  ]
}
